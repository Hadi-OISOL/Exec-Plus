# Use case: Documents all environment inputs required by local and hosted ExecPlus deployments.
# What it does: Supplies non-secret development defaults and placeholders for infrastructure and model configuration.

EXECPLUS_ENVIRONMENT=local
EXECPLUS_API_HOST=0.0.0.0
EXECPLUS_API_PORT=8000
EXECPLUS_LOG_LEVEL=INFO
EXECPLUS_DATABASE_URL=postgresql+psycopg://execplus:execplus@localhost:5432/execplus
EXECPLUS_OBJECT_STORE_ENDPOINT=http://localhost:9000
EXECPLUS_OBJECT_STORE_BUCKET=execplus-local
EXECPLUS_OBJECT_STORE_ACCESS_KEY=execplus
EXECPLUS_OBJECT_STORE_SECRET_KEY=change-me
EXECPLUS_LLM_MODE=disabled
EXECPLUS_LLM_BASE_URL=https://api.deepseek.com
EXECPLUS_LLM_API_KEY=
EXECPLUS_LLM_SMALL_MODEL=deepseek-v4-pro
EXECPLUS_LLM_LARGE_MODEL=deepseek-v4-pro
EXECPLUS_LLM_JSON_MODE=true
EXECPLUS_LLM_MAX_OUTPUT_TOKENS=1024
EXECPLUS_LLM_REASONING_EFFORT=none
EXECPLUS_LLM_SELECTION_BASE_URL=
EXECPLUS_LLM_SELECTION_MODEL=
EXECPLUS_LLM_SELECTION_API_KEY=
EXECPLUS_PRODUCTION_EVIDENCE_PATH=
EXECPLUS_VECTOR_MODE=disabled
EXECPLUS_MAX_UPLOAD_BYTES=20971520
EXECPLUS_QUERY_TIMEOUT_SECONDS=15.0
EXECPLUS_QUERY_MEMORY_LIMIT_MB=256
EXECPLUS_QUERY_ROW_LIMIT=10000
NEXT_PUBLIC_API_URL=http://localhost:8000


EXECPLUS_WEB_ORIGIN=http://localhost:3000

EXECPLUS_EMAIL_MODE=disabled
EXECPLUS_SMTP_HOST=
EXECPLUS_SMTP_PORT=465
EXECPLUS_SMTP_USERNAME=
EXECPLUS_SMTP_PASSWORD=
EXECPLUS_SMTP_SENDER=
