# Use case: Settings the owner fills in to put Syntelio on a public HTTPS address.
# What it does: Copied to /sdb-disk/OISOL_ExecPLUS/secrets/public.env (mode 600) and read by go-public.sh,
# go-private.sh and compose.public.yaml. Contains no secrets; app secrets stay in app.env.

# The public hostname, without https:// and without a trailing slash.
# Free now: sslip.io turns the server IP into a name, and Let's Encrypt can issue a certificate for it.
# Later: your own domain, e.g. app.example.com (create a DNS A record pointing at 173.208.151.137 first).
SYNTELIO_PUBLIC_HOST=syntelio.173-208-151-137.sslip.io

# Email Let's Encrypt uses for certificate-expiry notices. Not a secret, but use a mailbox you read.
SYNTELIO_ACME_EMAIL=owner@example.com

# Largest request Caddy accepts, in bytes. The API's own upload limit is EXECPLUS_MAX_UPLOAD_BYTES
# (20 MiB). 25 MiB sits just above it, so normal oversized files still get the API's clearer message.
SYNTELIO_MAX_REQUEST_BYTES=26214400

# Whether anyone on the internet may create an account. "true" keeps today's open sign-up.
# "false" blocks new self-service sign-ups (existing accounts keep working). Leave empty to not change it.
SYNTELIO_LOCAL_REGISTRATION_ENABLED=

# Leave empty on the VPS (real certificates). "tls internal" is only for a local rehearsal.
SYNTELIO_TLS=

# --- What go-public.sh writes into /sdb-disk/OISOL_ExecPLUS/secrets/app.env (for reference) ---
# It saves a timestamped copy of app.env first, then sets exactly these lines (others are untouched):
#   EXECPLUS_WEB_ORIGIN=https://<SYNTELIO_PUBLIC_HOST>
#   EXECPLUS_PUBLIC_API_URL=https://<SYNTELIO_PUBLIC_HOST>/api
#   EXECPLUS_SESSION_COOKIE_SECURE=true
#   EXECPLUS_TRUSTED_PROXIES=["127.0.0.1"]
#   EXECPLUS_CONNECTOR_ALLOW_PRIVATE_HOSTS=false
#   EXECPLUS_LOCAL_REGISTRATION_ENABLED=<value above, only if you set one>
# EXECPLUS_ENVIRONMENT stays "local": the password-account sign-in only runs in local/test mode.
#
# --- Google sign-in / Google Sheets (only if EXECPLUS_GOOGLE_CLIENT_ID is set in app.env) ---
# In Google Cloud Console > APIs & Services > Credentials > your OAuth client, add:
#   Authorized JavaScript origin:  https://<SYNTELIO_PUBLIC_HOST>
#   Authorized redirect URIs:      https://<SYNTELIO_PUBLIC_HOST>/api/auth/google/callback
#                                  https://<SYNTELIO_PUBLIC_HOST>/api/integrations/google/callback
# The client ID, client secret, picker key and EXECPLUS_TOKEN_ENCRYPTION_KEY are secrets: keep them only
# in app.env. Rotate the Google client secret and the DeepSeek key (EXECPLUS_LLM_API_KEY) before going
# public, because both were shared in chat earlier.
