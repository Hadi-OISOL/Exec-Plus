# Use case: Runs an isolated Qwen runtime for the private ExecPlus VPS demo.
# What it does: Keeps model files on sdb and bounds parallel work without changing other runtimes.

[Unit]
Description=ExecPlus private Qwen model runtime
After=network-online.target
RequiresMountsFor=/sdb-disk/AIML-Models/OISOL_ExecPLUS

[Service]
Type=simple
User=execplus-model
Group=administrator
WorkingDirectory=/sdb-disk/AIML-Models/OISOL_ExecPLUS
Environment=OLLAMA_HOST=127.0.0.1:11450
Environment=OLLAMA_MODELS=/sdb-disk/AIML-Models/OISOL_ExecPLUS/models
Environment=OLLAMA_NUM_PARALLEL=8
Environment=OLLAMA_CONTEXT_LENGTH=4096
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_MAX_QUEUE=16
Environment=OLLAMA_KEEP_ALIVE=5m
Environment=OLLAMA_NO_CLOUD=true
Environment=OLLAMA_DEBUG_LOG_REQUESTS=false
ExecStart=/opt/aiml/ollama/0.20.0/bin/ollama serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/sdb-disk/AIML-Models/OISOL_ExecPLUS
UMask=0077

[Install]
WantedBy=multi-user.target
