# Private release opt-in. Existing app.env entries override these nonsecret defaults.
# To disable new turns without losing historical readers, set these false in app.env
# and recreate API/jobs with the existing maintenance-lock procedure.
EXECPLUS_AGENT_CONTEXT_ENABLED=true
EXECPLUS_AGENT_ORCHESTRATION_ENABLED=true
EXECPLUS_AGENT_SYNTHESIS_ENABLED=true
EXECPLUS_AGENT_RETRIEVAL_EXPANSION_ENABLED=true
